# ~/.config/ghostty/config.ghostty — yours. omacos seeded it once.
# To take a newer default:  omacos refresh config ghostty/config.ghostty

font-family = "JetBrainsMono Nerd Font"
font-size = 14
adjust-cell-height = 12%

window-padding-x = 12
window-padding-y = 8
window-decoration = auto
window-save-state = always
macos-titlebar-style = tabs
macos-option-as-alt = true

cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 100000
confirm-close-surface = false

# Colours come from the active omacos theme. The leading ? means "ignore this
# if it does not exist yet", so Ghostty works before the first theme is applied.
config-file = ?~/.local/state/omacos/current/theme/ghostty.conf

# Your overrides — loaded last, so they win over both the defaults above and
# the theme. Never touched by omacos.
config-file = ?~/.config/ghostty/local.ghostty
