#!/usr/bin/env bash
# omacos:summary=Trim the terminal's inner padding, or put it back
# omacos:args=[on|off|status]
# omacos:examples=omacos toggle padding | omacos toggle padding status
#
# Ghostty leaves a margin between the window edge and the first character —
# omacos seeds 12 points at the sides and 8 top and bottom. That is roughly
# three columns and a line of text per window, spent on breathing room.
#
# Worth having on a laptop panel with one window; worth reclaiming on a tiled
# desktop where every window already has a gap and a border around it.
#
# `on` means the padding is on. This writes the same generated file the title
# bar setting uses, so it never edits a config that is yours.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

state="$OMACOS_STATE/current"
generated="$state/ghostty.conf"

padded_x=${OMACOS_PADDING_X:-12}
padded_y=${OMACOS_PADDING_Y:-8}

# `|| true` on every one of these: the file does not exist until something
# has been set, sed fails on a missing file, and under `set -e` with
# pipefail a failing command substitution ends the script — silently,
# because the error was already sent to /dev/null.
current_x() {
  local value
  if [[ -f $generated ]]; then
    value=$(sed -n 's/^window-padding-x *= *//p' "$generated" | head -1) || true
    [[ -n $value ]] && { printf '%s' "$value"; return 0; }
  fi
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config.ghostty"
  [[ -f $config ]] && value=$(sed -n 's/^window-padding-x *= *//p' "$config" | head -1) || true
  printf '%s' "${value:-$padded_x}"
}

# The generated file carries more than one setting, so rewrite it whole from
# what is in force rather than appending and hoping.
rewrite() {
  local x=$1 y=$2 titlebar
  titlebar=$(sed -n 's/^macos-titlebar-style *= *//p' "$generated" 2>/dev/null | head -1) || true
  mkdir -p "$state"
  {
    printf '# Generated by omacos — omacos toggle titlebar|padding\n'
    [[ -n $titlebar ]] && printf 'macos-titlebar-style = %s\n' "$titlebar"
    printf 'window-padding-x = %s\n' "$x"
    printf 'window-padding-y = %s\n' "$y"
  } > "$generated"
}

case ${1:-toggle} in
  status)
    if [[ $(current_x) == 0 ]]; then
      printf 'The terminal padding is off.\n'
      exit 1
    fi
    printf 'The terminal padding is on (%s x %s).\n' "$(current_x)" "$padded_y"
    ;;
  off)
    rewrite 0 0
    printf '\033[32mPadding off.\033[0m About three columns and a line back per window.\n'
    ;;
  on)
    rewrite "$padded_x" "$padded_y"
    printf '\033[33mPadding back to %s x %s.\033[0m\n' "$padded_x" "$padded_y"
    ;;
  toggle)
    if [[ $(current_x) == 0 ]]; then omacos-toggle-padding on; else omacos-toggle-padding off; fi
    ;;
  *) echo "usage: omacos toggle padding [on|off|status]" >&2; exit 1 ;;
esac

printf '\033[2mGhostty picks this up on Cmd-Shift-, (Reload Config).\033[0m\n'
