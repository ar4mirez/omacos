#!/usr/bin/env bash
# omacos:summary=Set the font the terminal and the bar both use
# omacos:args=[family] [size]
# omacos:examples=omacos font set | omacos font set "FiraCode Nerd Font" 13
#
# Omarchy's Style > Font sets one monospace font everywhere. Here the two
# places that ask are Ghostty and SketchyBar, and both read their font from a
# generated file rather than from the config you own — the same trick the theme
# already uses, so setting a font never rewrites a file that is yours.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

state="$OMACOS_STATE/current"
name_file="$state/font.name"
size_file="$state/font.size"

# Read once into a variable, not piped into grep -q. With pipefail, grep exits
# on the first match, the helper takes SIGPIPE, and the pipeline reports 141 —
# so a font that IS installed reads as missing. It works for a short list and
# inverts for a long one, which is the worst way for it to be wrong.
families=$(omacos-font-list) || families=""

family=${1:-}
size=${2:-}

# Whatever size is in force already, so setting a family does not silently
# reset one you chose.
current_size() {
  [[ -s $size_file ]] && { cat "$size_file"; return 0; }
  local ghostty="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config.ghostty"
  [[ -f $ghostty ]] && sed -n 's/^font-size *= *//p' "$ghostty" | head -1
}

if [[ -n $size ]]; then
  [[ $size =~ ^[0-9]+$ ]] && ((size >= 6 && size <= 72)) || {
    echo "Font size must be a whole number between 6 and 72." >&2; exit 1; }
fi

if [[ -z $family ]]; then
  # No terminal: this came from a menu row or a hotkey.
  if [[ ! -t 0 ]]; then
    exec omacos-launch-tui "omacos-font-set"
  fi
  command -v gum >/dev/null 2>&1 || {
    echo "usage: omacos font set <family>" >&2
    echo "Families on this machine:" >&2
    printf '%s\n' "$families" >&2
    exit 1
  }
  family=$(gum filter --placeholder "font family" --height 14 <<<"$families") || exit 0
  [[ -n $family ]] || exit 0
fi

# Checked against what is actually on this machine, because a font-family that
# resolves to nothing does not fail — Ghostty quietly draws in something else,
# and you are left wondering why nothing changed.
if [[ $'\n'$families$'\n' != *$'\n'"$family"$'\n'* ]]; then
  echo "No font family called '$family' on this machine." >&2
  echo "Install one with: omacos install app font.<name>   (omacos app list font)" >&2
  echo "Or see what you have: omacos font list" >&2
  exit 1
fi

mkdir -p "$state"
printf '%s\n' "$family" > "$name_file"
[[ -n $size ]] && printf '%s\n' "$size" > "$size_file"
size=$(current_size)

# Ghostty reads this through a `config-file = ?…` line in the seeded config, so
# it is loaded after the defaults and before your own local.ghostty.
#
# The empty assignment first is load-bearing: font-family is a *list* in
# Ghostty, and setting it again appends a fallback rather than replacing the
# primary. Without the reset the seeded default stays first and keeps
# rendering, and the only sign of it is that nothing changed. An empty value
# clears the list; the bold and italic families follow it.
{
  printf '# Generated by omacos — omacos font set\n'
  printf 'font-family = \n'
  printf 'font-family = "%s"\n' "$family"
  # font-size is a plain value rather than a list, so no reset is needed — but
  # it has to be written here too, or the seeded default wins over your choice.
  [[ -n $size ]] && printf 'font-size = %s\n' "$size"
} > "$state/font.conf"

# SketchyBar sources this; the bar re-reads it on --reload.
printf '# Generated by omacos — omacos font set\nFONT="%s"\n' "$family" > "$state/font.sh"

if command -v sketchybar >/dev/null 2>&1; then
  sketchybar --reload >/dev/null 2>&1 || true
fi

omacos-hook font-set "$family" || true

printf '\033[32mFont set to %s%s.\033[0m\n' "$family" "${size:+ at ${size}pt}"
# Ghostty has no way to be told from outside, so say it rather than let the
# terminal you are typing in look like the thing that failed.
printf '\033[2mGhostty picks it up on Cmd-Shift-, (Reload Config), or in a new window.\033[0m\n'
