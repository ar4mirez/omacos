#!/usr/bin/env bash
# omacos — self-documenting command dispatcher.
#
# Every script in bin/ named omacos-<group>-<verb> becomes `omacos <group> <verb>`.
# Help text comes from `# omacos:` metadata comments in the first METADATA_SCAN_LIMIT
# lines of each script, so adding a command never means editing this file.

set -uo pipefail

if ((BASH_VERSINFO[0] < 4)); then
  echo "omacos needs bash 4+ (macOS ships 3.2). Install it with: brew install bash" >&2
  exit 1
fi

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SELF_DIR/../default/env-bootstrap"

BIN_DIR="$OMACOS_PATH/bin"
METADATA_SCAN_LIMIT=80

declare -A GROUP_DESCRIPTIONS=(
  [theme]="Switch and manage themes"
  [install]="Install optional software"
  [app]="Inspect the app catalog"
  [remove]="Remove optional software"
  [refresh]="Re-sync a shipped config into ~/.config"
  [menu]="The omacos menu"
  [update]="Update omacos and packages"
  [migrate]="Run pending migrations"
  [webapp]="Install a website as an app"
  [tui]="Install a terminal app as an app"
  [default]="Which app fills which role"
  [setup]="One-time setup helpers"
  [state]="Read and write persistent state flags"
  [done]="One-shot completion markers"
  [git]="Git identities, per organisation"
  [hook]="User extension points"
  [dev]="Contributor tooling"
  [finalize]="Per-user setup"
  [cmd]="Small predicates and helpers"
  [doctor]="Check this machine's setup"
  [feature]="Enable or disable optional layers"
  [keymap]="Window manager keybindings"
  [window]="Pin a window to every workspace"
  [font]="Fonts on this machine"
  [launch]="Launch apps and TUIs"
  [capture]="Screenshots, recording, OCR and colours"
  [clipboard]="Clipboard history"
  [notice]="Time, battery and weather at a glance"
  [reminder]="Countdown reminders"
  [toggle]="Flip something on or off"
  [snapshot]="System snapshots you can roll back to"
  [system]="What this machine is"
  [network]="Speed test, DNS, and the Wi-Fi"
)

# ---------------------------------------------------------------- metadata ---

# Read `# omacos:key=value` pairs from a script into the given assoc array name.
read_metadata() {
  local file=$1 __arr=$2 line key value
  while IFS= read -r line; do
    [[ $line == *"omacos:"* ]] || continue
    [[ $line =~ ^[[:space:]]*#[[:space:]]*omacos:([a-z-]+)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
    printf -v "${__arr}[$key]" '%s' "$value"
  done < <(head -n "$METADATA_SCAN_LIMIT" "$file" 2>/dev/null)
}

# omacos-theme-set -> group "theme", name "set". omacos-doctor -> group "doctor", name "".
split_command_name() {
  local base=${1#omacos-}
  printf '%s\037%s\n' "${base%%-*}" "${base#*-}"
}

# Emit one TSV row per command: group, name, path, summary, args, hidden
each_command() {
  local file base group name summary
  for file in "$BIN_DIR"/omacos-*; do
    [[ -f $file && -x $file ]] || continue
    base=$(basename "$file")
    declare -A meta=()
    read_metadata "$file" meta
    IFS=$'\037' read -r group name < <(split_command_name "$base")
    [[ $name == "$group" ]] && name=""
    group=${meta[group]:-$group}
    name=${meta[name]:-$name}
    summary=${meta[summary]:-}
    printf '%s\037%s\037%s\037%s\037%s\037%s\n' \
      "$group" "$name" "$file" "$summary" "${meta[args]:-}" "${meta[hidden]:-false}"
    unset meta
  done
}

# ------------------------------------------------------------------- help ---

bold() { printf '\033[1m%s\033[0m' "$1"; }
dim()  { printf '\033[2m%s\033[0m' "$1"; }

usage_root() {
  printf '%s\n\n' "$(bold 'omacos') $(dim "v$(cat "$OMACOS_PATH/version")")"
  printf '  %s\n\n' "An omakase developer environment for macOS."
  printf '%s\n' "$(bold 'USAGE')"
  printf '  omacos <group> <command> [args]\n\n'
  printf '%s\n' "$(bold 'GROUPS')"
  local group
  while IFS= read -r group; do
    printf '  %-12s %s\n' "$group" "${GROUP_DESCRIPTIONS[$group]:-}"
  done < <(each_command | awk -F'\037' '$6!="true"{print $1}' | sort -u)
  printf '\n%s\n' "$(dim 'omacos <group> --help          commands in a group')"
  printf '%s\n' "$(dim 'omacos <group> <cmd> --help    what one command does')"
  printf '%s\n' "$(dim 'omacos commands --json         machine-readable command list')"
}

# One command in full: what it takes, what it does, and how it is actually used.
usage_command() {
  local file=$1 group name
  declare -A meta=()
  read_metadata "$file" meta
  IFS=$'\037' read -r group name < <(split_command_name "$(basename "$file")")
  [[ $name == "$group" ]] && name=""
  group=${meta[group]:-$group}
  name=${meta[name]:-$name}

  printf '%s %s\n' "$(bold "omacos $group${name:+ $name}")" "${meta[args]:-}"
  [[ -n ${meta[summary]:-} ]] && printf '  %s\n' "${meta[summary]}"
  if [[ -n ${meta[examples]:-} ]]; then
    printf '\n%s\n' "$(bold 'EXAMPLES')"
    # Examples are written on one metadata line, separated by " | ".
    printf '%s\n' "${meta[examples]}" | tr '|' '\n' | sed 's/^ *//; s/ *$//; s/^/  /'
  fi
  printf '\n%s\n' "$(dim "${file/#$HOME/\~}")"
}

# A self-documenting CLI is only self-documenting while every command carries
# its metadata. --check is what stops that from rotting silently.
commands_check() {
  local group name path summary problems=0
  while IFS=$'\037' read -r group name path summary _ _; do
    local label="omacos $group${name:+ $name}"
    if [[ ! -x $path ]]; then
      printf '%s: not executable\n' "$label"; problems=$((problems + 1)); continue
    fi
    if ! bash -n "$path" 2>/dev/null; then
      printf '%s: does not parse\n' "$label"; problems=$((problems + 1)); continue
    fi
    if [[ -z $summary ]]; then
      printf '%s: no `# omacos:summary=` line\n' "$label"; problems=$((problems + 1))
    fi
  done < <(each_command | sort)
  if ((problems)); then
    printf '\n%d problem(s).\n' "$problems"
    return 1
  fi
  printf 'All commands are executable, parse, and document themselves.\n'
}

usage_group() {
  local want=$1 group name summary args found=0
  printf '%s  %s\n\n' "$(bold "omacos $want")" "$(dim "${GROUP_DESCRIPTIONS[$want]:-}")"
  while IFS=$'\037' read -r group name _ summary args _; do
    [[ $group == "$want" ]] || continue
    found=1
    printf '  %-22s %s\n' "$name${args:+ $args}" "$summary"
  done < <(each_command | awk -F'\037' '$6!="true"' | sort)
  ((found)) || { printf '  %s\n' "No such group."; return 1; }
}

commands_json() {
  local group name path summary args first=1
  printf '['
  while IFS=$'\037' read -r group name path summary args _; do
    ((first)) || printf ','
    first=0
    local invocation="omacos $group${name:+ $name}"
    printf '{"group":"%s","name":"%s","command":"%s","summary":"%s","args":"%s","path":"%s"}' \
      "$group" "$name" "$invocation" "${summary//\"/\\\"}" "${args//\"/\\\"}" "$path"
  done < <(each_command | awk -F'\037' '$6!="true"' | sort)
  printf ']\n'
}

suggest() {
  local want=$1
  local hits
  hits=$(each_command | awk -F'\037' -v w="$want" '
    $6!="true" && substr($1,1,1)==substr(w,1,1) {print "  omacos " $1 ($2 ? " " $2 : "")}' | sort -u | head -5)
  [[ -n $hits ]] && { printf '\nDid you mean:\n%s\n' "$hits"; }
}

# --------------------------------------------------------------- dispatch ---

# Greedy longest-prefix match: `theme set x` tries omacos-theme-set-x, then
# omacos-theme-set, then omacos-theme.
resolve() {
  local -a parts=("$@")
  local i candidate
  for ((i = ${#parts[@]}; i > 0; i--)); do
    candidate="$BIN_DIR/omacos-$(IFS=-; echo "${parts[*]:0:i}")"
    if [[ -x $candidate ]]; then
      printf '%s\037%s\n' "$candidate" "$i"
      return 0
    fi
  done
  return 1
}

main() {
  if (($# == 0)) || [[ $1 == --help || $1 == -h || $1 == help ]]; then
    usage_root; exit 0
  fi
  case $1 in
    --version | -v) cat "$OMACOS_PATH/version"; exit 0 ;;
    commands)
      local include_hidden='$6!="true"'
      shift
      for argument in "$@"; do
        case $argument in
          --json)  commands_json; exit 0 ;;
          --check) commands_check; exit $? ;;
          --all)   include_hidden='1' ;;
          *) printf 'usage: omacos commands [--all] [--json] [--check]\n' >&2; exit 1 ;;
        esac
      done
      each_command | awk -F'\037' "$include_hidden"'{print "omacos " $1 ($2 ? " " $2 : "")}' | sort
      exit 0 ;;
  esac

  # `omacos theme --help` lists the group. Where the group is also a command in
  # its own right — `omacos reminder`, `omacos doctor` — document that first:
  # asking for help on it and getting only a list of its siblings is a dead end.
  if (($# == 2)) && [[ $2 == --help || $2 == -h ]] && [[ -n ${GROUP_DESCRIPTIONS[$1]:-} ]]; then
    local bare="$BIN_DIR/omacos-$1"
    if [[ -x $bare ]]; then
      usage_command "$bare"
      # Only worth listing the group as well when it holds more than this one.
      if (($(each_command | awk -F'\037' -v g="$1" '$1==g && $6!="true"' | wc -l) > 1)); then
        printf '\n'; usage_group "$1"
      fi
      exit 0
    fi
    usage_group "$1"; exit $?
  fi

  # `omacos theme set --help` documents that one command. It has to come after
  # the group check above, so `omacos theme --help` still lists the group.
  if (($# >= 2)) && [[ ${!#} == --help || ${!#} == -h ]]; then
    local -a without_help=("${@:1:$#-1}")
    local help_match
    if IFS=$'\037' read -r help_match _ < <(resolve "${without_help[@]}"); then
      usage_command "$help_match"; exit 0
    fi
  fi

  local match consumed
  if IFS=$'\037' read -r match consumed < <(resolve "$@"); then
    exec "$match" "${@:consumed+1}"
  fi

  printf '\033[31mUnknown command:\033[0m omacos %s\n' "$*" >&2
  suggest "$1" >&2
  exit 127
}

main "$@"
