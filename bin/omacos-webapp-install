#!/usr/bin/env bash
# omacos:summary=Install a website as a standalone app
# omacos:args=[name] [url] [icon] [--scheme "mailto ..."] [--handler <command>]
# omacos:examples=omacos webapp install Linear https://linear.app
#
# Creates a real .app in ~/Applications, so it gets its own Dock entry, its own
# window, and can be tiled like any other app. With no arguments it asks.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"
# shellcheck source=/dev/null
. "$OMACOS_PATH/default/lib/bundles.sh"

schemes=""
handler=""
positional=()
while (($#)); do
  case $1 in
    --scheme)  schemes=${2:?--scheme needs a value}; shift 2 ;;
    --handler) handler=${2:?--handler needs a value}; shift 2 ;;
    *)         positional+=("$1"); shift ;;
  esac
done
set -- ${positional[@]+"${positional[@]}"}

name=${1:-}; url=${2:-}; icon=${3:-}

if [[ -z $name || -z $url ]]; then
  # A keybinding or a menu row has no terminal to ask in, so move into one.
  if [[ ! -t 0 ]]; then
    exec omacos-launch-tui "omacos-webapp-install; echo; read -n 1 -s -r -p 'Press any key to close'"
  fi
  command -v gum >/dev/null || { echo "usage: omacos webapp install <name> <url>" >&2; exit 1; }
  printf "\033[32mA website, as an app you can launch and tile.\033[0m\n\n"
  [[ -n $name ]] || name=$(gum input --prompt "Name> " --placeholder "Linear")
  [[ -n $url ]]  || url=$(gum input --prompt "URL> " --placeholder "https://linear.app")
fi
[[ -n $name && -n $url ]] || { echo "usage: omacos webapp install <name> <url>" >&2; exit 1; }

# A name becomes a path, and a URL becomes a command line. Validate both.
[[ $name == */* || $name == .* ]] && { echo "Invalid name: $name" >&2; exit 1; }
# A bare domain is what people type; anything with another scheme is not a
# website, and Chromium's --app= would treat javascript: or file: as a document
# to run.
[[ $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || url="https://$url"
case $url in
  https://*|http://*) ;;
  *) echo "Refusing a non-http(s) URL: $url" >&2; exit 1 ;;
esac
[[ $url == *[[:space:]]* ]] && { echo "Refusing a URL containing whitespace" >&2; exit 1; }

# Chromium-family browsers can open a URL as a real app window. Safari cannot,
# so fall back to a normal browser window rather than pretending. Your own
# default comes first: having chosen Brave, you should not get Chrome.
browser=""
# shellcheck source=/dev/null
[[ -f $OMACOS_CONFIG/local.env ]] && . "$OMACOS_CONFIG/local.env"
for candidate in "${DEFAULT_BROWSER:-}" "Google Chrome" "Brave Browser" "Microsoft Edge" "Chromium" "Arc"; do
  [[ -n $candidate ]] || continue
  case $candidate in Safari|Firefox|Zen) continue ;; esac
  if [[ -d "/Applications/$candidate.app" || -d "$HOME/Applications/$candidate.app" ]]; then
    browser=$candidate; break
  fi
done

identifier="com.omacos.webapp.$(bundle_slug "$name")"

if [[ -n $schemes ]]; then
  [[ -n $handler ]] || handler="$OMACOS_PATH/bin/omacos-launch-webapp"
  app_dir=$(bundle_create_url_handler "$name" "$identifier" "$handler" "$schemes" "$url")
else
  if [[ -n $browser ]]; then
    launch="exec open -na $(printf '%q' "$browser") --args --app=$(printf '%q' "$url") --class=$(printf '%q' "$name")"
  else
    launch="exec open $(printf '%q' "$url")"
  fi
  app_dir=$(bundle_create "$name" "$identifier" "$launch" "$url")
fi

bundle_apply_icon "$app_dir" "$icon" "$url" || \
  printf '\033[2mNo icon found for %s; it will use the generic one.\033[0m\n' "$name"

bundle_register "$app_dir" "$schemes"

printf '\033[32mInstalled \033[1m%s\033[0m\033[32m → %s\033[0m\n' "$name" "${app_dir/#$HOME/\~}"
if [[ -z $browser && -z $schemes ]]; then
  printf '\033[2mNo Chromium-family browser found, so it opens in your default browser.\033[0m\n'
fi
if [[ -n $schemes ]]; then
  printf '\033[2mHandles: %s\033[0m\n' "$schemes"
fi
