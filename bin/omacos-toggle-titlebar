#!/usr/bin/env bash
# omacos:summary=Hide the terminal's title bar, or bring it back
# omacos:args=[on|off|status]
# omacos:examples=omacos toggle titlebar | omacos toggle titlebar status
#
# A tiling window manager makes a title bar close to pure overhead: it is
# roughly 28 points of every terminal window spent on a name you chose and
# three buttons you have keys for — alt-w closes, and JankyBorders already
# says which window has focus, in colour, around the whole edge.
#
# `hidden` rather than `window-decoration = none`: it removes the bar while
# leaving a window macOS still considers normal, which is what AeroSpace needs
# to keep moving and resizing it.
#
# The setting goes in a generated file the seeded Ghostty config loads, so this
# never edits a config that is yours.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

state="$OMACOS_STATE/current"
generated="$state/ghostty.conf"

# What is in force: the generated file wins, then whatever the seeded config
# says, and Ghostty's own default last.
current() {
  if [[ -f $generated ]]; then
    local value
    value=$(sed -n 's/^macos-titlebar-style *= *//p' "$generated" | head -1) || true
    [[ -n $value ]] && { printf '%s' "$value"; return 0; }
  fi
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config.ghostty"
  if [[ -f $config ]]; then
    local value
    value=$(sed -n 's/^macos-titlebar-style *= *//p' "$config" | head -1) || true
    [[ -n $value ]] && { printf '%s' "$value"; return 0; }
  fi
  printf 'transparent'
}

# The file carries the padding settings too, so keep whatever is already there
# rather than writing this one key over the top of them.
apply() {
  local padding_x padding_y
  padding_x=$(sed -n 's/^window-padding-x *= *//p' "$generated" 2>/dev/null | head -1) || true
  padding_y=$(sed -n 's/^window-padding-y *= *//p' "$generated" 2>/dev/null | head -1) || true
  mkdir -p "$state"
  {
    printf '# Generated by omacos — omacos toggle titlebar|padding\n'
    printf 'macos-titlebar-style = %s\n' "$1"
    [[ -n $padding_x ]] && printf 'window-padding-x = %s\n' "$padding_x"
    [[ -n $padding_y ]] && printf 'window-padding-y = %s\n' "$padding_y"
  } > "$generated"
}

# Says whether Ghostty is loading the file at all. Without the include, this
# writes a setting nothing reads — which would look exactly like a bug.
warn_if_not_included() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config.ghostty"
  [[ -f $config ]] || return 0
  grep -q 'current/ghostty.conf' "$config" && return 0
  printf '\033[33mYour Ghostty config does not load this yet.\033[0m\n' >&2
  printf 'Take the newer default, which adds one line:\n\n' >&2
  printf '    \033[36momacos refresh config ghostty/config.ghostty\033[0m\n\n' >&2
  printf '\033[2m(Your own settings belong in ~/.config/ghostty/local.ghostty,\n' >&2
  printf 'which omacos never writes.)\033[0m\n' >&2
}

# Not the same advice as the font settings, which do update a running terminal
# on reload. Ghostty's own documentation for this one says: "Changing this
# option at runtime only applies to new windows." Telling someone to reload is
# telling them to watch nothing happen.
reloaded() {
  printf '\033[2mOpen a new window to see it — Ghostty only applies this one to new\n'
  printf 'windows, so reloading the config leaves the ones you have alone.\033[0m\n'
}

case ${1:-toggle} in
  status)
    if [[ $(current) == hidden ]]; then
      printf 'The title bar is hidden.\n'
    else
      printf 'The title bar is shown (%s).\n' "$(current)"
      exit 1
    fi
    ;;
  on|hide)
    apply hidden
    printf '\033[32mTitle bar hidden.\033[0m\n'
    warn_if_not_included
    reloaded
    ;;
  off|show)
    # tabs is what omacos seeds, and the only style that keeps Ghostty's own
    # tab bar looking like part of the window.
    apply tabs
    printf '\033[33mTitle bar back.\033[0m\n'
    warn_if_not_included
    reloaded
    ;;
  toggle)
    if [[ $(current) == hidden ]]; then omacos-toggle-titlebar off; else omacos-toggle-titlebar on; fi
    ;;
  *) echo "usage: omacos toggle titlebar [on|off|status]" >&2; exit 1 ;;
esac
