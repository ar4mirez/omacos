#!/usr/bin/env bash
# omacos:summary=Show every keybinding, grouped by what it does
# omacos:args=[--window|--plain]
# omacos:examples=omacos keymap show
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

keymap="$OMACOS_CONFIG/keymap.conf"
[[ -f $keymap ]] || { echo "No keymap at $keymap" >&2; exit 1; }

# Opened from a keybinding: show it in its own terminal window instead of
# printing into whatever happens to be focused.
if [[ ${1:-} == --window ]]; then
  exec omacos-launch-tui "omacos-keymap-show; echo; read -n 1 -s -r -p 'Press any key to close'"
fi

render() {
  awk -F'|' '
    function flush_section() { if (section != "") printf "\n\033[1m%s\033[0m\n", section }
    /^#[ \t]*---+/ {
      # Section headers in the keymap are `# ---- name ----`. Three dashes at
      # least: a comment that merely opens with a flag — `# --focus-follows-
      # window, or ...` — is prose, and was being drawn as a heading.
      line = $0
      gsub(/^#[ \t-]+|[ \t-]+$/, "", line)
      if (line != "") { section = toupper(substr(line,1,1)) substr(line,2); flush_section(); section = "" }
      next
    }
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    {
      key = $1; desc = $2
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", desc)
      if (key == "" || desc == "") next
      printf "  \033[36m%-22s\033[0m %s\n", key, desc
    }
  ' "$keymap"
}

if [[ ${1:-} == --plain ]]; then
  render | sed $'s/\033\[[0-9;]*m//g'
else
  printf '\033[1momacos keybindings\033[0m  \033[2m(from ~/.config/omacos/keymap.conf)\033[0m\n'
  # When Caps Lock is remapped to option, "alt" below is reachable under the
  # left pinky — worth saying, since the keymap cannot know.
  # Read first, then match: piping into `grep -q` makes the writer take
  # SIGPIPE, and pipefail turns that into a failure.
  caps_mapping=$(hidutil property --get UserKeyMapping 2>/dev/null) || caps_mapping=""
  if [[ $caps_mapping == *30064771129* ]]; then
    printf '\033[2malt is also Caps Lock on this machine.\033[0m\n'
  fi
  render
  printf '\n\033[2mEdit the keymap, then run: omacos keymap build\033[0m\n'
fi
