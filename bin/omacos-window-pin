#!/usr/bin/env bash
# omacos:summary=Pin the focused window so it follows you to every workspace
# omacos:args=[list|clear]
# omacos:examples=omacos window pin | omacos window pin list | omacos window pin clear
#
# Omarchy's Super+O pops a window out of its workspace allocation and pins it
# as a floating overlay that follows you wherever you go. AeroSpace has no
# sticky windows, so this assembles the same behaviour from two things it does
# have: a floating layout, and a callback on every workspace change.
#
# A pin is a window id on disk. `omacos window follow-pinned` runs from
# exec-on-workspace-change and does the moving; this command only decides
# which windows are in the set. The file records the layout the window had
# before it was pinned, so unpinning puts it back where it was rather than
# guessing.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

pins="$OMACOS_STATE/pinned"

# Every pinned id, one per line. Missing directory is not an error: it is the
# ordinary case of nothing being pinned.
pinned_ids() {
  [[ -d $pins ]] || return 0
  local file
  for file in "$pins"/*; do
    [[ -e $file ]] || continue
    printf '%s\n' "${file##*/}"
  done
}

app_named() {
  aerospace list-windows --all --format '%{window-id}|%{app-name}' 2>/dev/null \
    | awk -F'|' -v want="$1" '$1 == want { print $2; exit }'
}

unpin() {
  local id=$1 was
  was=$(cat "$pins/$id" 2>/dev/null || true)
  rm -f "$pins/$id"
  # A window that was tiled before the pin goes back to tiled. One the user had
  # already floated stays floating — the pin did not make it float, so lifting
  # the pin has no business un-floating it.
  if [[ $was != floating ]]; then
    aerospace layout --window-id "$id" tiling >/dev/null 2>&1 || true
  fi
}

case ${1:-toggle} in
  list)
    ids=$(pinned_ids)
    [[ -n $ids ]] || { printf 'Nothing is pinned.\n'; exit 0; }
    while read -r id; do
      name=$(app_named "$id" || true)
      # A closed window's pin is reaped by follow-pinned on the next workspace
      # switch, so it can legitimately still be listed here.
      printf '%s\t%s\n' "$id" "${name:-(closed)}"
    done <<<"$ids"
    ;;

  clear)
    ids=$(pinned_ids)
    [[ -n $ids ]] || { printf 'Nothing is pinned.\n'; exit 0; }
    count=0
    while read -r id; do
      unpin "$id"
      count=$((count + 1))
    done <<<"$ids"
    printf '\033[33mUnpinned %s window(s).\033[0m\n' "$count"
    ;;

  toggle)
    # Only pinning needs the window manager. Listing and clearing are about the
    # set on disk, and have to keep working on a machine with no desktop layer
    # — including the one that runs at startup to drop yesterday's pins.
    command -v aerospace >/dev/null 2>&1 || {
      echo "Pinning a window needs AeroSpace: omacos install feature desktop" >&2
      exit 1
    }
    id=$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null | head -1) || id=""
    [[ -n $id ]] || { echo "Nothing is focused." >&2; exit 1; }
    name=$(app_named "$id" || true)

    if [[ -e $pins/$id ]]; then
      unpin "$id"
      omacos-cmd-notify "Unpinned" "${name:-The window} stays on this workspace." || true
      printf '\033[33mUnpinned %s.\033[0m\n' "${name:-window $id}"
    else
      mkdir -p "$pins"
      # Recorded before the layout is changed, or the record is of our own doing.
      layout=$(aerospace list-windows --focused --format '%{window-layout}' 2>/dev/null | head -1)
      [[ $layout == floating ]] || layout=tiling
      printf '%s\n' "$layout" > "$pins/$id"
      aerospace layout --window-id "$id" floating >/dev/null 2>&1 || true
      omacos-cmd-notify "Pinned" "${name:-The window} now follows you to every workspace." || true
      printf '\033[32mPinned %s.\033[0m\n' "${name:-window $id}"
    fi
    ;;

  *)
    echo "usage: omacos window pin [list|clear]" >&2
    exit 1
    ;;
esac
