#!/usr/bin/env bash
# omacos:summary=Snapshot, update omacos, run migrations, and upgrade packages
# omacos:args=[-y]
# omacos:examples=omacos update | omacos update -y
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

unattended=false
for argument in "$@"; do
  case $argument in
    -y) unattended=true ;;
    *) echo "usage: omacos update [-y]" >&2; exit 1 ;;
  esac
done

lock="$OMACOS_STATE/update.lock"
mkdir -p "$OMACOS_STATE"
if ! mkdir "$lock" 2>/dev/null; then
  echo "An update is already running." >&2; exit 1
fi
trap 'rm -rf "$lock"' EXIT

step() { printf '\n\033[1;34m▸\033[0m \033[1m%s\033[0m\n' "$1"; }

# -y is a promise not to ask anything, so it is also what CI and hooks pass.
if ! $unattended && [[ -t 0 ]] && command -v gum >/dev/null; then
  gum confirm "Snapshot this machine, then update omacos and upgrade packages?" || exit 0
fi

# Before anything is changed, not after: the point of the snapshot is to
# capture the machine that still worked. It is copy-on-write, so this costs a
# second and no disk until the upgrade below starts diverging from it.
#
# There is deliberately no way to skip this. A flag to turn it off would only
# ever be reached for on the update you were in a hurry about, which is the
# one you most want to be able to walk back from. Where a snapshot genuinely
# cannot be taken — not APFS, no space — the step says so and the update
# carries on, which covers the honest cases without offering a footgun.
step "Snapshot"
omacos-snapshot-create 2>&1 | sed 's/^/  /' || \
  echo "  Could not snapshot — continuing without one."

step "Fetching omacos"
if [[ -d $OMACOS_PATH/.git ]]; then
  before=$(git -C "$OMACOS_PATH" rev-parse HEAD)
  if git -C "$OMACOS_PATH" pull --ff-only 2>&1 | sed 's/^/  /'; then
    after=$(git -C "$OMACOS_PATH" rev-parse HEAD)
    [[ $before == "$after" ]] && echo "  Already up to date."
  else
    echo "  Could not fast-forward — you have local changes. Skipping." >&2
  fi
else
  echo "  Not a git checkout; skipping."
fi

step "Packages"
brew bundle install --file "$OMACOS_PATH/Brewfile" --no-upgrade 2>&1 | sed 's/^/  /'
if omacos-feature check desktop 2>/dev/null; then
  brew bundle install --file "$OMACOS_PATH/Brewfile.desktop" --no-upgrade 2>&1 | sed 's/^/  /'
fi
if omacos-feature check apps 2>/dev/null; then
  # Not `brew bundle`: several of these are .pkg casks that need a terminal to
  # prompt for sudo on, and an unattended `omacos update -y` has none. The
  # installer knows to relaunch itself into one.
  mapfile -t app_casks < <(grep '^cask ' "$OMACOS_PATH/Brewfile.apps" | cut -d'"' -f2)
  ((${#app_casks[@]})) && omacos-install-app "${app_casks[@]}" 2>&1 | sed 's/^/  /'
fi

# `brew bundle install` above only installs what is missing. Omarchy's one
# Update command also moves everything already installed forward, and now that
# a snapshot precedes it, so does this one.
#
# Casks are held back when nobody is watching: a .pkg cask asks for sudo, and
# an unattended run — CI, a hook, `omacos update -y` from a keybinding — has no
# terminal for that prompt to appear in and would hang waiting on it.
#
# Neither upgrade is allowed to end the run. One package failing to build is a
# normal Tuesday, and it must not cost you the migrations and the config
# seeding that come after it — those are the parts that keep this machine
# consistent with the code that was just pulled.
brew update >/dev/null 2>&1 || true
if $unattended || [[ ! -t 0 ]]; then
  brew upgrade --formula 2>&1 | sed 's/^/  /' || echo "  Some formulae did not upgrade."
  echo "  Casks skipped: upgrading them can need sudo. Run: brew upgrade --cask"
else
  brew upgrade 2>&1 | sed 's/^/  /' || echo "  Some packages did not upgrade."
fi

step "Migrations"
# Migrations ship with the code fetched above and are written against it, so
# they run after the pull and before anything that depends on the new layout.
omacos-migrate

step "Config"
# Seeds any config file added since the last update. Existing files are yours
# and are never touched.
seeded=0
while IFS= read -r -d '' source_file; do
  relative=${source_file#"$OMACOS_PATH"/config/}
  target="${XDG_CONFIG_HOME:-$HOME/.config}/$relative"
  [[ -e $target ]] && continue
  mkdir -p "$(dirname "$target")"
  cp "$source_file" "$target"
  printf '  seeded %s\n' "$relative"
  seeded=$((seeded + 1))
done < <(find "$OMACOS_PATH/config" -type f -print0 2>/dev/null)
((seeded)) || echo "  Nothing new to seed."

step "Refresh"
command -v omacos-keymap-build >/dev/null && omacos-feature check desktop 2>/dev/null && omacos-keymap-build
theme=$(omacos-theme-current 2>/dev/null || echo "")
[[ -n $theme ]] && omacos-theme-set "$theme" >/dev/null && echo "  Reapplied theme: $theme"

omacos-hook post-update || true

# Anything that asked for a restart during this run says so once, here.
for marker in "$OMACOS_STATE"/restart-*-required; do
  [[ -e $marker ]] || continue
  name=$(basename "$marker"); name=${name#restart-}; name=${name%-required}
  printf '\n\033[33m!\033[0m Restart %s to pick up changes.\n' "$name"
  rm -f "$marker"
done

printf '\n\033[1;32momacos is up to date.\033[0m\n'
