#!/usr/bin/env bash
# omacos:summary=Check that this machine is set up the way omacos expects
# omacos:args=[--quiet]
# omacos:examples=omacos doctor
#
# Everything here is a read-only check. Nothing is repaired automatically: the
# point is to tell you what is actually true on a machine, especially the three
# things that cannot be scripted (Accessibility grants, 1Password's two toggles).
set -uo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

quiet=false; [[ ${1:-} == --quiet ]] && quiet=true
pass=0; warn=0; fail=0

ok()   { ((pass++)); $quiet || printf '  \033[32m✓\033[0m %s\n' "$1"; }
note() { ((warn++)); printf '  \033[33m!\033[0m %s\n' "$1"; [[ -n ${2:-} ]] && printf '      \033[2m%s\033[0m\n' "$2"; }
bad()  { ((fail++)); printf '  \033[31m✗\033[0m %s\n' "$1"; [[ -n ${2:-} ]] && printf '      \033[2m%s\033[0m\n' "$2"; }
section() { printf '\n\033[1m%s\033[0m\n' "$1"; }

section "omacos"
if [[ ! -d $OMACOS_PATH ]]; then
  bad "OMACOS_PATH missing: $OMACOS_PATH"
elif [[ $OMACOS_PATH == "$HOME/.local/share/omacos" ]]; then
  ok "OMACOS_PATH  $OMACOS_PATH"
  # env-bootstrap silently falls back when a linked checkout has gone, which is
  # the right thing to do and the wrong thing to say nothing about: the machine
  # looks normal while still carrying a link to a tree that no longer exists.
  if [[ -f $OMACOS_CONFIG/path.conf ]]; then
    stale=$(sed -n 's/^OMACOS_PATH=//p' "$OMACOS_CONFIG/path.conf" | head -1)
    note "Ignoring a stale dev link" "${stale//\'/} is gone — clear it with: omacos dev unlink"
  fi
else
  # Worth saying plainly: while linked, `omacos update` pulls into your
  # checkout rather than the installed tree.
  note "Linked to a working checkout" "$OMACOS_PATH — return with: omacos dev unlink"
fi
case ":$PATH:" in *":$OMACOS_PATH/bin:"*) ok "bin/ is on PATH" ;;
  *) note "bin/ is not on PATH" "Open a new shell, or source ~/.config/zsh/.zshrc" ;; esac
if command -v omacos >/dev/null; then ok "omacos resolves to $(command -v omacos)"; else bad "omacos not on PATH"; fi
if omacos migrate --pending >/dev/null 2>&1; then
  note "Migrations pending" "Run: omacos update"
else ok "No pending migrations"; fi

section "Platform"
os=$(sw_vers -productVersion)
case ${os%%.*} in
  27) note "macOS $os is very new" "AeroSpace and SketchyBar have limited testing on 27" ;;
  26) ok "macOS $os" ;;
  *)  note "macOS $os is older than this project targets" ;;
esac
[[ $(uname -m) == arm64 ]] && ok "Apple silicon (arm64)" || bad "Unsupported architecture: $(uname -m)"
# Captured rather than piped into grep -q: with pipefail, grep exiting early
# SIGPIPEs the writer and the pipeline returns 141. It happens to work for
# short output and silently inverts for long output.
sip_status=$(csrutil status 2>/dev/null) || sip_status=""
if [[ $sip_status == *enabled* ]]; then ok "SIP enabled (AeroSpace needs no exception)"
else note "SIP is disabled" "omacos does not require this"; fi

section "Homebrew"
if command -v brew >/dev/null; then
  ok "brew $(brew --version | head -1 | awk '{print $2}')"
  for tap in nikitabobko/tap felixkratz/formulae; do
    taps=$(brew tap 2>/dev/null) || taps=""
    if grep -qix "$tap" <<<"$taps"; then ok "tap $tap"
    else note "tap $tap missing" "Run: brew tap $tap"; fi
  done
  if [[ -f $OMACOS_PATH/Brewfile ]]; then
    if brew bundle check --file "$OMACOS_PATH/Brewfile" >/dev/null 2>&1; then ok "Brewfile satisfied"
    else note "Brewfile not fully installed" "Run: brew bundle install --file $OMACOS_PATH/Brewfile"; fi
  fi
else bad "Homebrew not installed"; fi

section "Seeded config"
if omacos-done check seed 2>/dev/null; then ok "Config seeded"
else note "Config not seeded yet" "Run: omacos-install or $OMACOS_PATH/install.sh"; fi
for dir in "$OMACOS_CONFIG" "$OMACOS_STATE"; do
  [[ -d $dir ]] && ok "$(printf '%s' "${dir/#$HOME/\~}")" || note "missing ${dir/#$HOME/\~}"
done

section "Identity"
if git config --global user.email >/dev/null 2>&1; then
  ok "git identity: $(git config --global user.name) <$(git config --global user.email)>"
else note "No global git identity" "Set GIT_NAME/GIT_EMAIL in $OMACOS_CONFIG/local.env"; fi
if command -v gh >/dev/null; then
  if gh auth status >/dev/null 2>&1; then ok "gh authenticated"; else note "gh not authenticated" "Run: gh auth login"; fi
fi

section "1Password"
op_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
[[ -d /Applications/1Password.app ]] && ok "1Password app installed" || note "1Password app not installed"
command -v op >/dev/null && ok "op CLI $(op --version 2>/dev/null)" \
  || note "op CLI not installed" "brew install --cask 1password-cli"
if [[ -S $op_sock ]]; then
  ok "SSH agent socket is live"
  if [[ $(git config --global gpg.format 2>/dev/null) == ssh ]]; then
    signing_key=$(git config --global user.signingkey 2>/dev/null)
    ok "Commit signing configured (${signing_key##* })"
  else
    note "Commit signing not set up" "Run: omacos setup signing"
  fi
else
  note "1Password SSH agent not running" "Enable: 1Password > Settings > Developer > Use the SSH agent"
fi

section "Desktop"
if ! omacos-feature check desktop 2>/dev/null; then
  ok "Desktop layer off (enable with: omacos feature enable desktop)"
else
  # Accessibility state lives in TCC.db, which is unreadable without Full Disk
  # Access. Whether the server answers is the honest proxy.
  if [[ ! -d /Applications/AeroSpace.app ]]; then
    bad "AeroSpace not installed" "Run: omacos install feature desktop"
  elif aerospace list-workspaces --all >/dev/null 2>&1; then
    ok "AeroSpace running ($(aerospace list-workspaces --focused 2>/dev/null | head -1) focused)"
  elif pgrep -qx AeroSpace 2>/dev/null; then
    bad "AeroSpace is running but not responding" \
        "Almost always a missing Accessibility grant: System Settings > Privacy & Security > Accessibility"
  else
    note "AeroSpace not running" "Run: open -a AeroSpace"
  fi

  for service in sketchybar borders; do
    if ! command -v "$service" >/dev/null; then
      bad "$service not installed" "Run: omacos install feature desktop"
    elif pgrep -qx "$service" 2>/dev/null; then
      ok "$service running"
    else
      note "$service not running" "It starts with AeroSpace, or run: $service &"
    fi
  done

  [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/aerospace/aerospace.toml ]] \
    && ok "aerospace.toml generated" \
    || note "aerospace.toml missing" "Run: omacos keymap build"
fi

printf '\n\033[1m%d passed\033[0m, \033[33m%d to look at\033[0m, \033[31m%d broken\033[0m\n' "$pass" "$warn" "$fail"
((fail == 0))
