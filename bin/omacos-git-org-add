#!/usr/bin/env bash
# omacos:summary=Give an organisation its own git identity under ~/Work/<Org>/
# omacos:args=<Org> [--name X] [--email Y] [--key KeyName] [--no-sign]
# omacos:examples=omacos git org add Cuemby | omacos git org add Acme --email me@acme.com --key "Acme"
#
# Every repo under ~/Work/<Org>/ then uses that identity automatically: name,
# email, signing key and SSH key, chosen by directory rather than by you
# remembering to set it per clone.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"
# shellcheck source=/dev/null
. "$OMACOS_PATH/default/lib/agent-keys.sh"

org=${1:-}; shift || true
[[ -n $org ]] || { echo "usage: omacos git org add <Org> [--name X] [--email Y] [--key K]" >&2; exit 1; }
# An org name becomes a directory and a config path.
[[ $org == */* || $org == .* ]] && { echo "Invalid organisation name: $org" >&2; exit 1; }

name="" email="" key="" sign=true
while (($#)); do
  case $1 in
    --name)    name=${2:?}; shift 2 ;;
    --email)   email=${2:?}; shift 2 ;;
    --key)     key=${2:?}; shift 2 ;;
    --no-sign) sign=false; shift ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# shellcheck source=/dev/null
[[ -f $OMACOS_CONFIG/local.env ]] && . "$OMACOS_CONFIG/local.env"
work_dir=${WORK_DIR:-$HOME/Work}
org_dir="$work_dir/$org"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/git/orgs"
org_config="$config_dir/$org"
mkdir -p "$config_dir" "$org_dir"

if [[ -z $name ]]; then
  if command -v gum >/dev/null && [[ -t 0 ]]; then
    name=$(gum input --prompt "Name for $org: " --value "$(git config --global user.name || true)")
  else
    name=$(git config --global user.name || true)
  fi
fi
if [[ -z $email ]]; then
  if command -v gum >/dev/null && [[ -t 0 ]]; then
    email=$(gum input --prompt "Email for $org: " --placeholder "you@$(tr '[:upper:]' '[:lower:]' <<<"$org").com")
  else
    echo "Pass --email for $org." >&2; exit 1
  fi
fi
[[ -n $name && -n $email ]] || { echo "Both a name and an email are required." >&2; exit 1; }

{
  printf '# git identity for %s — used by every repo under %s/\n' "$org" "${org_dir/#$HOME/\~}"
  printf '# Generated by `omacos git org add %s`; safe to edit by hand.\n\n' "$org"
  printf '[user]\n\tname = %s\n\temail = %s\n' "$name" "$email"
} > "$org_config"

if agent_is_live; then
  if [[ -n $key ]]; then
    public_key=$(resolve_agent_key "$key")
  elif [[ -t 0 ]]; then
    public_key=$(choose_agent_key "Which SSH key for $org?") || public_key=""
  else
    public_key=""
  fi

  if [[ -n ${public_key:-} ]]; then
    pubfile=$(export_public_key "$public_key")
    # Written with `git config`, not printf: the ssh command embeds double
    # quotes (the agent socket path has a space in it), and git's config parser
    # strips quotes it did not write itself.
    git config -f "$org_config" core.sshCommand "$(ssh_command_for "$pubfile")"
    if $sign; then
      git config -f "$org_config" user.signingkey "$public_key"
      git config -f "$org_config" commit.gpgsign true
    fi
  fi
fi

# Case-insensitive match: the default macOS filesystem is, so gitdir alone
# silently misses ~/work/acme.
#
# Git matches gitdir against the resolved path, so register the physical one
# too whenever it differs — on macOS /var is a symlink to /private/var, and a
# logical-only pattern silently never matches.
physical_dir=$(cd "$org_dir" && pwd -P)
git config --global "includeIf.gitdir/i:$org_dir/.path" "$org_config"
if [[ $physical_dir != "$org_dir" ]]; then
  git config --global "includeIf.gitdir/i:$physical_dir/.path" "$org_config"
fi

printf '\033[32m%s\033[0m\n' "$org"
printf '  identity  %s <%s>\n' "$name" "$email"
[[ -n ${public_key:-} ]] && printf '  ssh key   %s\n' "$(key_name "$public_key")"
printf '  applies   %s/**\n' "${org_dir/#$HOME/\~}"
printf '  config    %s\n' "${org_config/#$HOME/\~}"
