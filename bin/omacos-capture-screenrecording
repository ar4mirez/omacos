#!/usr/bin/env bash
# omacos:summary=Start or stop a screen recording
# omacos:args=[region|fullscreen] [--with-audio] [--stop]
# omacos:examples=omacos capture screenrecording | omacos capture screenrecording --stop
#
# One hotkey starts and stops, so this is a toggle: with a recording already
# running, every invocation stops it.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

pidfile="$OMACOS_STATE/screenrecording.pid"
targetfile="$OMACOS_STATE/screenrecording.path"

recording_pid() {
  [[ -f $pidfile ]] || return 1
  local pid; pid=$(cat "$pidfile" 2>/dev/null) || return 1
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

refresh_bar() {
  command -v sketchybar >/dev/null 2>&1 || return 0
  sketchybar --trigger omacos_recording >/dev/null 2>&1 || true
}

stop_recording() {
  local pid=$1 target
  target=$(cat "$targetfile" 2>/dev/null || echo "")
  # SIGINT, not SIGTERM: screencapture finalises the movie on an interrupt and
  # abandons a corrupt file on anything harsher.
  kill -INT "$pid" 2>/dev/null || true
  for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  rm -f "$pidfile" "$targetfile"
  refresh_bar
  if [[ -n $target && -f $target ]]; then
    omacos-cmd-notify "Recording stopped" "${target##*/}" || true
    printf '\033[32mSaved\033[0m %s\n' "${target/#$HOME/\~}"
  else
    printf 'Recording stopped.\n'
  fi
}

mode=fullscreen
audio=false
stop_only=false
for argument in "$@"; do
  case $argument in
    region | fullscreen) mode=$argument ;;
    --with-audio) audio=true ;;
    --stop | --stop-recording) stop_only=true ;;
    *) echo "usage: omacos capture screenrecording [region|fullscreen] [--with-audio] [--stop]" >&2; exit 1 ;;
  esac
done

if pid=$(recording_pid); then
  stop_recording "$pid"
  exit 0
fi
if $stop_only; then
  printf 'Nothing is recording.\n'
  exit 0
fi

directory=${OMACOS_SCREENSHOT_DIR:-$(defaults read com.apple.screencapture location 2>/dev/null || echo "$HOME/Pictures/Screenshots")}
directory=${directory/#\~/$HOME}
mkdir -p "$directory"
target="$directory/Recording $(date '+%Y-%m-%d at %H.%M.%S').mov"

flags=(-v -x)
if [[ $mode == region ]]; then flags+=(-i -J video); fi
if $audio; then flags+=(-g); fi

mkdir -p "$OMACOS_STATE"
printf '%s\n' "$target" > "$targetfile"
nohup screencapture "${flags[@]}" "$target" >/dev/null 2>&1 &
printf '%s\n' "$!" > "$pidfile"
refresh_bar

omacos-cmd-notify "Recording" "Run it again to stop." || true
printf '\033[32mRecording\033[0m %s\n' "${target/#$HOME/\~}"
