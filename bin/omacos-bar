#!/usr/bin/env bash
# omacos:summary=Where the omacos bar sits, and whether you can see through it
# omacos:args=<position [top|bottom]> | <transparent [on|off]>
# omacos:examples=omacos bar position bottom | omacos bar transparent on
#
# Omarchy's bar is dragged to a screen edge with the mouse. SketchyBar has no
# drag, so this is the same choice as a command — and it is worth having for a
# reason Omarchy does not share: macOS already draws a menu bar across the top,
# so a bar at the top is the second one up there. Moving it to the bottom ends
# that, and so does hiding the menu bar with `omacos toggle menubar`.
#
# Both settings live in a generated file the seeded sketchybarrc sources, so
# neither ever rewrites a config that is yours.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

state="$OMACOS_STATE/current"
settings="$state/bar.sh"

read_setting() {
  local key=$1 fallback=$2
  [[ -f $settings ]] || { printf '%s' "$fallback"; return 0; }
  local value
  value=$(sed -n "s/^$key=//p" "$settings" | head -1 | tr -d '"')
  printf '%s' "${value:-$fallback}"
}

write_settings() {
  mkdir -p "$state"
  {
    printf '# Generated by omacos — omacos bar position|transparent\n'
    printf 'BAR_POSITION=%s\n' "$1"
    printf 'BAR_TRANSPARENT=%s\n' "$2"
  } > "$settings"
  command -v sketchybar >/dev/null 2>&1 && sketchybar --reload >/dev/null 2>&1 || true
  # The gap that keeps windows off the bar lives in aerospace.toml, which is
  # generated — so moving the bar means regenerating it.
  command -v omacos-keymap-build >/dev/null 2>&1 && omacos-keymap-build >/dev/null 2>&1 || true
}

position=$(read_setting BAR_POSITION top)
transparent=$(read_setting BAR_TRANSPARENT false)

case ${1:-} in
  position)
    case ${2:-} in
      "")
        printf '%s\n' "$position"
        ;;
      top|bottom)
        write_settings "$2" "$transparent"
        printf '\033[32mThe bar is at the %s.\033[0m\n' "$2"
        # Read, then compare. Piping into grep -q under pipefail reports the
        # writer's SIGPIPE as a failure, which here would invert the answer.
        menubar=$(defaults read NSGlobalDomain _HIHideMenuBar 2>/dev/null || echo 0)
        if [[ $2 == top && $menubar != 1 ]]; then
          printf '\033[2mmacOS draws its menu bar there too — `omacos toggle menubar`\n'
          printf 'hides that one if two rows is one too many.\033[0m\n'
        fi
        ;;
      *) echo "usage: omacos bar position [top|bottom]" >&2; exit 1 ;;
    esac
    ;;
  transparent)
    case ${2:-toggle} in
      status) [[ $transparent == true ]] && printf 'The bar is transparent.\n' || { printf 'The bar is opaque.\n'; exit 1; } ;;
      on)     write_settings "$position" true;  printf '\033[32mThe bar is transparent.\033[0m\n' ;;
      off)    write_settings "$position" false; printf '\033[33mThe bar is opaque.\033[0m\n' ;;
      toggle)
        if [[ $transparent == true ]]; then
          write_settings "$position" false; printf '\033[33mThe bar is opaque.\033[0m\n'
        else
          write_settings "$position" true;  printf '\033[32mThe bar is transparent.\033[0m\n'
        fi
        ;;
      *) echo "usage: omacos bar transparent [on|off|status]" >&2; exit 1 ;;
    esac
    ;;
  ""|status)
    printf 'position:    %s\n' "$position"
    printf 'transparent: %s\n' "$transparent"
    ;;
  *) echo "usage: omacos bar <position [top|bottom]|transparent [on|off]>" >&2; exit 1 ;;
esac
