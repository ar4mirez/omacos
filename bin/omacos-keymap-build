#!/usr/bin/env bash
# omacos:summary=Regenerate aerospace.toml from your keymap
# omacos:examples=omacos keymap build
#
# aerospace.toml is static TOML, so a keymap written straight into it cannot
# document itself. keymap.conf is the source of truth; this turns it into both
# the AeroSpace config and the cheatsheet.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

keymap="$OMACOS_CONFIG/keymap.conf"
base="$OMACOS_PATH/default/aerospace/base.toml"
local_extra="$OMACOS_CONFIG/aerospace.local.toml"
target="${XDG_CONFIG_HOME:-$HOME/.config}/aerospace/aerospace.toml"

[[ -f $keymap ]] || { echo "No keymap at $keymap" >&2; exit 1; }
mkdir -p "$(dirname "$target")"

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

{
  echo "# GENERATED BY omacos — DO NOT EDIT."
  echo "# Edit ~/.config/omacos/keymap.conf, then run: omacos keymap build"
  echo "# Extra settings of your own go in ~/.config/omacos/aerospace.local.toml"
  # Keep workspaces alive even when empty so the bar always shows the same set.
  # Derived from the keymap, so there is still one source of truth.
  # This must precede base.toml: a bare key after a table header belongs to
  # that table, and base.toml ends with [[on-window-detected]].
  # Flags are skipped, so `workspace --auto-back-and-forth S` still names S.
  # `next` and `prev` are directions, not workspaces, and would otherwise be
  # persisted as two workspaces called "next" and "prev".
  workspaces=$(grep -oE "\\| *workspace( --[a-z-]+)* [A-Za-z0-9]+ *$" "$keymap" \
               | awk '{print $NF}' | grep -vxE 'next|prev' \
               | sort -u -V | sed 's/.*/"&"/' | paste -sd, -)
  [[ -n $workspaces ]] && echo "persistent-workspaces = [$workspaces]"

  echo
  # Gaps are a config value with no runtime command, so toggling them means
  # regenerating. Zero the [gaps] block in place rather than appending a second
  # one — two [gaps] tables is invalid TOML, which AeroSpace rejects wholesale.
  #
  # The edge the omacos bar is on gets the bar's height added to its gap.
  # macOS reserves no space for SketchyBar — NSScreen.visibleFrame is the whole
  # display — so AeroSpace tiles under it and the bottom (or top) of every
  # window sits behind the bar. Measured at 36pt of overlap before this.
  bar_edge="" bar_reserve=0
  if omacos-feature check desktop 2>/dev/null && ! omacos-state check bar-hidden 2>/dev/null; then
    bar_edge=$(omacos-bar position 2>/dev/null || echo top)
    bar_reserve=${OMACOS_BAR_HEIGHT:-36}
  fi

  if omacos-state check gaps-off 2>/dev/null; then
    # Gaps off still leaves room for the bar: a window underneath it is not a
    # tighter layout, it is a hidden line of text.
    awk -v edge="$bar_edge" -v reserve="$bar_reserve" '
      /^\[gaps\]/            { in_gaps = 1; print; next }
      /^\[/ && !/^\[gaps\]/  { in_gaps = 0 }
      in_gaps && /^outer\.top *=/    { printf "outer.top = %d\n", (edge == "top" ? reserve : 0); next }
      in_gaps && /^outer\.bottom *=/ { printf "outer.bottom = %d\n", (edge == "bottom" ? reserve : 0); next }
      in_gaps && /[a-z]+ *=/  { sub(/=.*/, "= 0"); print; next }
      { print }
    ' "$base"
  else
    awk -v edge="$bar_edge" -v reserve="$bar_reserve" '
      /^\[gaps\]/            { in_gaps = 1; print; next }
      /^\[/ && !/^\[gaps\]/  { in_gaps = 0 }
      in_gaps && /^outer\.top *=/ && edge == "top" {
        split($0, part, "="); printf "outer.top = %d\n", part[2] + reserve; next }
      in_gaps && /^outer\.bottom *=/ && edge == "bottom" {
        split($0, part, "="); printf "outer.bottom = %d\n", part[2] + reserve; next }
      { print }
    ' "$base"
  fi
  echo
  echo "[mode.main.binding]"
  awk -F'|' '
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    {
      key = $1; action = $3
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", action)
      if (key == "" || action == "") next
      # A duplicate key is invalid TOML, so keep one entry per key: the last
      # definition wins, and the first appearance fixes the ordering.
      if (!(key in value)) order[++n] = key
      else printf("omacos keymap: duplicate binding for %s — the last one wins\n", key) > "/dev/stderr"
      # An action starting with [ is a TOML array: several commands run in
      # order. It has to reach the file verbatim — wrapping it in quotes, or
      # stripping the quotes inside it, yields a line AeroSpace rejects, and a
      # rejected config leaves every binding in the file inert.
      if (action ~ /^\[/) {
        literal[key] = 1
      } else {
        # The value is emitted inside single quotes, so a single quote in the
        # action cannot survive — it would end the TOML string early. Stripping
        # it silently turns `-p '"'"'Press any key'"'"'` into three arguments, which is
        # the kind of thing you only notice by pressing the key. Say so.
        if (action ~ /'"'"'/) {
          printf("omacos keymap: %s has quotes in its action; they are being removed\n", key) > "/dev/stderr"
          printf("  put the quoting inside the command instead of in the keymap\n") > "/dev/stderr"
        }
        gsub(/'"'"'/, "", action)
        literal[key] = 0
      }
      value[key] = action
    }
    END {
      for (i = 1; i <= n; i++) {
        k = order[i]
        if (literal[k]) printf "%s = %s\n", k, value[k]
        else printf "%s = '"'"'%s'"'"'\n", k, value[k]
      }
    }
  ' "$keymap"

  # Resize and service modes are structural, not user keymap material.
  cat <<'MODES'

[mode.resize.binding]
h = 'resize width -50'
j = 'resize height +50'
k = 'resize height -50'
l = 'resize width +50'
enter = 'mode main'
esc = 'mode main'

[mode.service.binding]
esc = ['reload-config', 'mode main']
r = ['flatten-workspace-tree', 'mode main']
f = ['layout floating tiling', 'mode main']
backspace = ['close-all-windows-but-current', 'mode main']
MODES

  if [[ -f $local_extra ]]; then
    echo
    echo "# ---- from ~/.config/omacos/aerospace.local.toml ----"
    echo "# Note: this is appended after a table header, so start it with one"
    echo "# of your own (e.g. [gaps]) rather than bare top-level keys."
    cat "$local_extra"
  fi
} > "$tmp"

mv "$tmp" "$target"
trap - EXIT

count=$(grep -cE "^[a-z0-9-]+ = ('|\[)" "$target" || true)
printf '\033[32mWrote %s\033[0m \033[2m(%s bindings)\033[0m\n' "${target/#$HOME/\~}" "$count"

# Asking the server is the real liveness test: the process is named AeroSpace,
# not aerospace, and it can be running yet unresponsive while it waits on its
# Accessibility grant.
if command -v aerospace >/dev/null && aerospace list-workspaces --all >/dev/null 2>&1; then
  # A rejected config is not a partial config: AeroSpace keeps the one it had,
  # so every binding in the file just written is inert. Reporting that as a
  # success — which `reload-config && printf` quietly did — means finding out
  # by pressing a key that does nothing.
  if aerospace reload-config; then
    printf '\033[2mAeroSpace reloaded.\033[0m\n'
  else
    printf '\033[31mAeroSpace rejected the config above; the previous one is still in effect.\033[0m\n'
    printf '\033[2mFix the named binding in ~/.config/omacos/keymap.conf and build again.\033[0m\n'
    exit 1
  fi
elif [[ -d /Applications/AeroSpace.app ]]; then
  printf '\033[2mAeroSpace is not responding; it will pick this up on next start.\033[0m\n'
fi
