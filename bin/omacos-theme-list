#!/usr/bin/env bash
# omacos:summary=List available themes
# omacos:args=[--plain]
# omacos:examples=omacos theme list
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

current=$(cat "$OMACOS_STATE/current/theme.name" 2>/dev/null || echo "")
plain=false; [[ ${1:-} == --plain ]] && plain=true

list_from() {
  local dir=$1 origin=$2 path name mode
  [[ -d $dir ]] || return 0
  for path in "$dir"/*/; do
    [[ -f $path/colors.toml ]] || continue
    name=$(basename "$path")
    if $plain; then printf '%s\n' "$name"; continue; fi
    mode=$(awk -F'"' '/^[ \t]*mode[ \t]*=/{print $2; exit}' "$path/colors.toml")
    if [[ $name == "$current" ]]; then
      printf '  \033[32m●\033[0m \033[1m%-20s\033[0m \033[2m%s  %s\033[0m\n' "$name" "${mode:-dark}" "$origin"
    else
      printf '    %-20s \033[2m%s  %s\033[0m\n' "$name" "${mode:-dark}" "$origin"
    fi
  done
}

list_from "$OMACOS_PATH/themes" "shipped"
list_from "$OMACOS_CONFIG/themes" "yours"
