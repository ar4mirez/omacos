#!/usr/bin/env bash
# omacos:summary=Generate a gradient wallpaper from a theme's palette
# omacos:args=<theme-name> [width] [height]
# omacos:examples=omacos dev make-wallpaper tokyo-night
#
# Themes need a wallpaper to look finished, but shipping photographs bloats the
# repo. A gradient derived from the palette is a few KB and always matches.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

theme=${1:?usage: omacos dev make-wallpaper <theme> [w] [h]}
width=${2:-2560}
height=${3:-1600}
palette="$OMACOS_PATH/themes/$theme/colors.toml"
[[ -f $palette ]] || { echo "No such theme: $theme" >&2; exit 1; }

out_dir="$OMACOS_PATH/themes/$theme/backgrounds"
mkdir -p "$out_dir"

python3 - "$palette" "$out_dir/01-gradient.png" "$width" "$height" <<'PY'
import re, struct, sys, zlib

palette_path, out_path, width, height = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])

colors = {}
for line in open(palette_path):
    m = re.match(r'\s*([a-z_]+)\s*=\s*"(.*?)"', line)
    if m:
        colors[m.group(1)] = m.group(2)

def rgb(name, fallback="#000000"):
    value = colors.get(name, fallback).lstrip("#")
    return tuple(int(value[i:i+2], 16) for i in (0, 2, 4))

# Darkest at the bottom, with a wash of the accent through the middle, so the
# gradient reads as part of the theme rather than a generic backdrop.
top    = rgb("dark_background", "#1a1b26")
bottom = rgb("darker_background", "#0e0e14")
accent = rgb("accent", "#7aa2f7")

rows = bytearray()
for y in range(height):
    t = y / max(height - 1, 1)
    # Accent peaks a third of the way down, gently.
    wash = 0.10 * (1 - abs(t - 0.33) / 0.67) ** 2
    row = bytearray([0])  # PNG filter type 0 for this scanline
    px = bytes(
        int(round(top[c] + (bottom[c] - top[c]) * t + (accent[c] - top[c]) * wash))
        for c in range(3)
    )
    row += px * width
    rows += row

def chunk(tag, data):
    return (struct.pack(">I", len(data)) + tag + data
            + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))

png = (b"\x89PNG\r\n\x1a\n"
       + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
       + chunk(b"IDAT", zlib.compress(bytes(rows), 9))
       + chunk(b"IEND", b""))
open(out_path, "wb").write(png)
print(f"{out_path} ({len(png) / 1024:.0f} KB)")
PY
