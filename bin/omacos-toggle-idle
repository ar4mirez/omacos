#!/usr/bin/env bash
# omacos:summary=Keep the screen awake, or let it sleep again
# omacos:args=[on|off|status]
# omacos:examples=omacos toggle idle
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

pidfile="$OMACOS_STATE/caffeinate.pid"

keeper_pid() {
  [[ -f $pidfile ]] || return 1
  local pid; pid=$(cat "$pidfile" 2>/dev/null) || return 1
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

refresh_bar() {
  command -v sketchybar >/dev/null 2>&1 || return 0
  sketchybar --trigger omacos_idle >/dev/null 2>&1 || true
}

start() {
  mkdir -p "$OMACOS_STATE"
  # -d display, -i idle sleep, -m disk, -s system while on AC, -u as if you had
  # just touched the keyboard. caffeinate exits with its child or on a signal,
  # so the pid file is the whole of the state.
  nohup caffeinate -dimsu >/dev/null 2>&1 &
  printf '%s\n' "$!" > "$pidfile"
  refresh_bar
  omacos-cmd-notify "Staying awake" "Screen and system sleep are held off." || true
  printf '\033[32mIdle sleep is held off.\033[0m\n'
}

stop() {
  local pid=$1
  kill "$pid" 2>/dev/null || true
  rm -f "$pidfile"
  refresh_bar
  omacos-cmd-notify "Sleep allowed" "Back to the usual energy settings." || true
  printf '\033[33mIdle sleep is allowed again.\033[0m\n'
}

case ${1:-toggle} in
  status)
    # Exit code as well as words: the menu uses this as a predicate to draw a
    # tick beside the row.
    if keeper_pid >/dev/null; then
      printf 'Idle sleep is held off.\n'
    else
      printf 'Idle sleep is allowed.\n'; exit 1
    fi
    ;;
  on)
    if keeper_pid >/dev/null; then printf 'Already staying awake.\n'; else start; fi
    ;;
  off)
    if pid=$(keeper_pid); then stop "$pid"; else printf 'Not holding sleep off.\n'; fi
    ;;
  toggle)
    if pid=$(keeper_pid); then stop "$pid"; else start; fi
    ;;
  *) echo "usage: omacos toggle idle [on|off|status]" >&2; exit 1 ;;
esac
