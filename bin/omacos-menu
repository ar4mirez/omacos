#!/usr/bin/env bash
# omacos:summary=The omacos menu
# omacos:args=[route]
# omacos:examples=omacos menu | omacos menu style.theme
#
# Rows are keyed by dotted id; the parent is inferred from the id, so adding a
# row never means editing navigation code. Users add or override rows in
# ~/.config/omacos/extensions/omacos-menu.jsonc — reusing an id replaces the
# shipped row.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

# A keybinding runs us through AeroSpace's exec-and-forget, which has no
# terminal attached — and gum cannot draw without one. Relaunch into a floating
# Ghostty window so the same command works from a key and from a shell.
pidfile="$OMACOS_STATE/menu.pid"

menu_already_running() {
  [[ -f $pidfile ]] || return 1
  local pid; pid=$(cat "$pidfile" 2>/dev/null) || return 1
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

if [[ ! -t 0 && ${1:-} != --list ]]; then
  # Pressing the key twice should bring the menu forward, not stack a second
  # window on the first. A pid file rather than a window-title match: a window
  # that is still starting has no title yet, which made that check racy.
  if menu_already_running; then
    if command -v aerospace >/dev/null 2>&1; then
      existing=$(aerospace list-windows --all --format '%{window-id}|%{window-title}' 2>/dev/null \
                 | awk -F'|' '$2 == "omacos" { print $1; exit }')
      [[ -n ${existing:-} ]] && exec aerospace focus --window-id "$existing"
    fi
    exit 0
  fi
  exec omacos-launch-tui "omacos-menu ${1:-}"
fi

# Running with a terminal: this is the instance the user interacts with.
if [[ ${1:-} != --list ]]; then
  mkdir -p "$OMACOS_STATE"
  printf '%s\n' "$$" > "$pidfile"
  trap 'rm -f "$pidfile"' EXIT
fi

command -v gum >/dev/null || { echo "omacos menu needs gum: brew install gum" >&2; exit 1; }
command -v jq  >/dev/null || { echo "omacos menu needs jq: brew install jq" >&2; exit 1; }

shipped="$OMACOS_PATH/default/menu.json"
extension="$OMACOS_CONFIG/extensions/omacos-menu.jsonc"

# strip_jsonc lives with the catalog, which reads a JSONC overlay the same way.
# shellcheck source=/dev/null
. "$OMACOS_PATH/default/lib/catalog.sh"

load_menu() {
  if [[ -f $extension ]]; then
    jq -s '.[0] * .[1]' "$shipped" <(strip_jsonc "$extension")
  else
    cat "$shipped"
  fi
}

MENU_JSON=$(load_menu)

# Direct children of a route: ids with exactly one more dotted segment.
children_of() {
  local route=$1
  if [[ $route == root ]]; then
    jq -r 'to_entries[] | select(.key | test("^[^.]+$")) | .key' <<<"$MENU_JSON"
  else
    jq -r --arg p "$route" 'to_entries[]
      | select(.key | startswith($p + "."))
      | select((.key | ltrimstr($p + ".")) | test("^[^.]+$"))
      | .key' <<<"$MENU_JSON"
  fi
}

field() { jq -r --arg k "$1" --arg f "$2" '.[$k][$f] // empty' <<<"$MENU_JSON"; }

# Three guards, each a shell condition, so rows reflect live system state
# instead of a stale snapshot:
#   when      hides the row when it fails
#   checked   ticks the row when it succeeds — "this is the current choice"
#   disabled  ticks the row and makes it unselectable — "already installed".
#             Install rows use it so software you have reads as installed
#             rather than vanishing from the list.
visible() {
  local when; when=$(field "$1" when)
  [[ -z $when ]] && return 0
  bash -c "$when" >/dev/null 2>&1
}
guard_passes() {
  local condition; condition=$(field "$1" "$2")
  [[ -z $condition ]] && return 1
  bash -c "$condition" >/dev/null 2>&1
}

# Every row of a route, static and provided, as
#   id <TAB> icon <TAB> label <TAB> action <TAB> ok|checked|disabled
#
# A provider says only which state a row is in; the tick that shows it is added
# here, so every provider does not have to remember to.
#
# Read it back through read_rows, never with IFS=$'\t' directly: a tab counts
# as IFS whitespace, so bash collapses a run of them and a submenu's empty
# action column silently swallows the one after it.
#
# A `provider` is a command printing those same five columns. Install and
# Remove use one: their rows come from the app catalog, and listing ~80 of them
# by hand here would only duplicate it. It also costs one presence snapshot for
# a whole category rather than a forked guard per row.
rows_for() {
  local route=$1 id provider state mark
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    visible "$id" || continue
    state=ok; mark=""
    if guard_passes "$id" disabled; then state=disabled; mark="  ✓"
    elif guard_passes "$id" checked; then mark="  ✓"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$id" "$(field "$id" icon)" "$(field "$id" label)$mark" "$(field "$id" action)" "$state"
  done < <(children_of "$route")

  provider=$(field "$route" provider)
  if [[ -n $provider ]]; then
    bash -c "$provider" 2>/dev/null | awk -F'\t' -v OFS='\t' '
      NF >= 5 { if ($5 == "checked" || $5 == "disabled") $3 = $3 "  ✓"; print }' || true
  fi
  return 0
}

# Tab on the wire, unit separator for the split — \037 is not IFS whitespace,
# so empty columns survive.
read_rows() { rows_for "$1" | tr '\t' '\037'; }

# --list is for scripting and tests: print a route's rows and exit. A disabled
# row is listed with its tick, the way it is on screen.
if [[ ${1:-} == --list ]]; then
  read_rows "${2:-root}" | while IFS=$'\037' read -r id _ label action _; do
    [[ -n $id ]] || continue
    printf '%s\t%s\t%s\n' "$id" "$label" "$action"
  done
  exit 0
fi

route=${1:-root}
trail=()

while :; do
  labels=(); ids=(); actions=(); states=()
  while IFS=$'\037' read -r id icon label action state; do
    [[ -n $id ]] || continue
    ids+=("$id")
    actions+=("$action")
    states+=("$state")
    labels+=("$(printf '%s  %s' "$icon" "$label")")
  done < <(read_rows "$route")

  ((${#ids[@]})) || { echo "Nothing here." >&2; exit 0; }

  if [[ $route == root ]]; then
    header="omacos"
  else
    # `title` lets a row read "Browser" in its parent while the open menu says
    # "Default browser".
    title=$(field "$route" title)
    [[ -n $title ]] || title=${route//./ · }
    header="omacos · $title"
    labels+=("←  Back")
  fi

  choice=$(printf '%s\n' "${labels[@]}" | gum filter --placeholder "$header" --height 14 --prompt "› ") || exit 0

  if [[ $choice == "←  Back" ]]; then
    if ((${#trail[@]})); then
      route=${trail[-1]}
      unset "trail[${#trail[@]}-1]"
    else
      route=root
    fi
    continue
  fi

  selected=""; index=-1
  for i in "${!labels[@]}"; do
    if [[ ${labels[i]} == "$choice" ]]; then selected=${ids[i]:-}; index=$i; break; fi
  done
  [[ -n $selected ]] || exit 0

  # A disabled row stays on screen — it is telling you something — but there is
  # nothing to do with it.
  if [[ ${states[index]} == disabled ]]; then
    continue
  fi

  action=${actions[index]}
  if [[ -n $action ]]; then
    eval "$action"
    exit 0
  fi

  trail+=("$route")
  route=$selected
done
