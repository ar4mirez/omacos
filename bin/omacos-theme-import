#!/usr/bin/env bash
# omacos:summary=Convert an Omarchy theme into an omacos one
# omacos:args=<directory|omarchy-theme-name> [name] [--shipped]
# omacos:examples=omacos theme import nord | omacos theme import ~/src/mytheme
#
# Omarchy's colors.toml is flat TOML in the same shape as ours, so a port is a
# mechanical mapping plus four colours Omarchy does not define. Doing it as a
# converter rather than by hand means anyone can pull in a community theme, not
# just the ones omacos happens to ship.
#
# Wallpapers are never copied — they are not the theme author's to relicense in
# every case. One is generated from the palette instead.
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

source_arg=${1:-}
[[ -n $source_arg ]] || { echo "usage: omacos theme import <directory|name> [name] [--shipped]" >&2; exit 1; }
shift

name=""
shipped=false
for argument in "$@"; do
  case $argument in
    --shipped) shipped=true ;;
    *) name=$argument ;;
  esac
done

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

if [[ -d $source_arg ]]; then
  source_dir=$source_arg
else
  # A bare name means an Omarchy theme; fetch just the two files we read.
  [[ $source_arg =~ ^[a-z0-9-]+$ ]] || { echo "Not a directory, and not a theme name: $source_arg" >&2; exit 1; }
  base="https://raw.githubusercontent.com/basecamp/omarchy/master/themes/$source_arg"
  source_dir="$scratch/$source_arg"
  mkdir -p "$source_dir"
  if ! curl -fsSL "$base/colors.toml" -o "$source_dir/colors.toml"; then
    echo "No Omarchy theme called $source_arg." >&2
    exit 1
  fi
  curl -fsSL "$base/neovim.lua" -o "$source_dir/neovim.lua" 2>/dev/null || true
fi

[[ -f $source_dir/colors.toml ]] || { echo "No colors.toml in $source_dir" >&2; exit 1; }
[[ -n $name ]] || name=$(basename "$source_dir")
[[ $name =~ ^[a-z0-9-]+$ ]] || { echo "Theme name must be lowercase, digits and dashes: $name" >&2; exit 1; }

if $shipped; then target="$OMACOS_PATH/themes/$name"; else target="$OMACOS_CONFIG/themes/$name"; fi
mkdir -p "$target"

# bat ships a fixed set; a name it does not know silently falls back to its
# default, which is how two of the themes omacos shipped ended up unstyled.
bat_themes=$(bat --list-themes 2>/dev/null) || bat_themes=""

python3 - "$source_dir" "$target/colors.toml" "$name" <<'PY' "$bat_themes"
import re, sys

source_dir, out_path, name = sys.argv[1], sys.argv[2], sys.argv[3]
bat_themes = [t for t in sys.argv[4].splitlines() if t.strip()]

palette = {}
with open(f"{source_dir}/colors.toml") as handle:
    for line in handle:
        match = re.match(r'\s*([a-z_]+)\s*=\s*"([^"]+)"', line)
        if match:
            palette[match.group(1)] = match.group(2)

def need(key):
    if key not in palette:
        sys.exit(f"omacos: the source palette has no '{key}'")
    return palette[key]

mode = palette.get("mode", "dark")

# Omarchy defines no ANSI 0/7/8/15. Follow the convention the existing omacos
# themes already use rather than inventing a fifth one.
derived = {
    "black":        palette.get("dark_background", need("background")),
    "white":        need("foreground"),
    "bright_black": need("muted"),
    "bright_white": palette.get("bright_foreground", need("foreground")),
}

# Neovim's plugin and colorscheme live in the theme's neovim.lua, not its palette.
nvim_plugin, nvim_colorscheme = "folke/tokyonight.nvim", "tokyonight-night"
try:
    lua = open(f"{source_dir}/neovim.lua").read()
    plugin = re.search(r'"([\w.-]+/[\w.-]+)"', lua)
    scheme = re.search(r'colorscheme\s*=\s*"([^"]+)"', lua)
    if plugin:
        nvim_plugin = plugin.group(1)
    if scheme:
        nvim_colorscheme = scheme.group(1)
except OSError:
    pass
nvim_plugin_name = nvim_plugin.split("/")[-1].removesuffix(".nvim")

# Match the theme against bat's own list before trusting a name to it.
def pick_bat_theme():
    def norm(value):
        return re.sub(r'[^a-z0-9]', '', value.lower())
    wanted = norm(name)
    for candidate in bat_themes:
        if norm(candidate) == wanted:
            return candidate
    for candidate in bat_themes:
        if wanted and (wanted in norm(candidate) or norm(candidate) in wanted):
            return candidate
    return "ansi"

lines = [
    f"# {name} — ported from Omarchy (MIT, (c) David Heinemeier Hansson).",
    "# See themes/ATTRIBUTION.md. Generated by `omacos theme import`.",
    f'mode = "{mode}"',
    "",
]
for key in ("accent", "selection", "muted",
            "background", "dark_background", "darker_background", "lighter_background",
            "foreground", "dark_foreground", "light_foreground", "bright_foreground"):
    lines.append(f'{key} = "{need(key)}"')
lines.append("")
for key in ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"):
    lines.append(f'{key} = "{derived.get(key) or need(key)}"')
lines.append("")
for key in ("bright_black", "bright_red", "bright_green", "bright_yellow",
            "bright_blue", "bright_magenta", "bright_cyan", "bright_white"):
    # A theme that defines no bright variant reuses its normal one.
    value = derived.get(key) or palette.get(key) or need(key.removeprefix("bright_"))
    lines.append(f'{key} = "{value}"')
lines += [
    "",
    f'bat_theme = "{pick_bat_theme()}"',
    f'nvim_plugin = "{nvim_plugin}"',
    f'nvim_plugin_name = "{nvim_plugin_name}"',
    f'nvim_colorscheme = "{nvim_colorscheme}"',
    "",
]
open(out_path, "w").write("\n".join(lines))
print(f"  palette: {len(palette)} keys in, {sum(1 for l in lines if ' = ' in l)} out")
PY

# Never copy the source's wallpapers: they are not always the theme author's
# to relicense. Generate one from the palette, which is what every shipped
# omacos theme already does.
omacos-dev-make-wallpaper "$name" >/dev/null

printf '\033[32mImported\033[0m %s\n' "${target/#$HOME/\~}"
printf '\033[2mTry it with: omacos theme set %s\033[0m\n' "$name"
