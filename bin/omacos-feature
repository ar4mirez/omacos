#!/usr/bin/env bash
# omacos:summary=Enable or disable an optional omacos layer
# omacos:args=<enable|disable|check|list> [name]
# omacos:examples=omacos feature list | omacos feature enable desktop
#
# Features are user intent, so they live in ~/.config (yours) rather than state.
# `check` is a predicate: `omacos feature check desktop && ...`
set -euo pipefail
. "$(dirname -- "${BASH_SOURCE[0]}")/../default/env-bootstrap"

# Only list flags something actually checks. statusbar and borders were
# here and read by nothing, which promises granularity that does not exist:
# they come with `desktop`.
KNOWN=(desktop apps hyper)
features_file="$OMACOS_CONFIG/features"

command=${1:-list}; name=${2:-}
mkdir -p "$OMACOS_CONFIG"; touch "$features_file"

is_known() { local f; for f in "${KNOWN[@]}"; do [[ $f == "$1" ]] && return 0; done; return 1; }

case $command in
  list)
    for f in "${KNOWN[@]}"; do
      if grep -qxF "$f" "$features_file"; then printf '  \033[32m✓\033[0m %s\n' "$f"
      else printf '  \033[2m·  %s\033[0m\n' "$f"; fi
    done ;;
  check)
    [[ -n $name ]] || { echo "usage: omacos feature check <name>" >&2; exit 2; }
    grep -qxF "$name" "$features_file" ;;
  enable)
    is_known "$name" || { echo "Unknown feature: $name (known: ${KNOWN[*]})" >&2; exit 1; }
    grep -qxF "$name" "$features_file" || echo "$name" >> "$features_file"
    printf '\033[32mEnabled %s\033[0m\n' "$name" ;;
  disable)
    is_known "$name" || { echo "Unknown feature: $name (known: ${KNOWN[*]})" >&2; exit 1; }
    grep -vxF "$name" "$features_file" > "$features_file.tmp" || true
    mv "$features_file.tmp" "$features_file"
    printf '\033[33mDisabled %s\033[0m\n' "$name" ;;
  *) echo "usage: omacos feature <enable|disable|check|list> [name]" >&2; exit 1 ;;
esac
