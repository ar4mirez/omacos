{
  "style":               { "icon": "◐", "label": "Style" },
  "style.theme":         { "icon": "◑", "label": "Theme", "action": "omacos-menu-theme" },
  "style.theme-next":    { "icon": "◒", "label": "Next theme", "action": "omacos-theme-next" },
  "style.background":    { "icon": "▨", "label": "Next background", "action": "omacos-theme-background" },
  "style.light-dark":    { "icon": "☀", "label": "Toggle light/dark", "action": "omacos-cmd-toggle-appearance" },

  "apps":                { "icon": "\u25a6", "label": "Apps" },
  "apps.music":          { "icon": "♪", "label": "Music", "action": "omacos-launch-app music", "when": "omacos-launch-app music --has" },
  "apps.password":       { "icon": "⚿", "label": "Password manager", "action": "omacos-launch-app password", "when": "omacos-launch-app password --has" },
  "apps.calendar":       { "icon": "▦", "label": "Calendar", "action": "omacos-launch-app calendar", "when": "omacos-launch-app calendar --has" },
  "apps.email":          { "icon": "✉", "label": "Email", "action": "omacos-launch-app email", "when": "omacos-launch-app email --has" },
  "apps.notes":          { "icon": "✎", "label": "Notes", "action": "omacos-launch-app notes", "when": "omacos-launch-app notes --has" },
  "apps.writing":        { "icon": "✍", "label": "Writing", "action": "omacos-launch-app writing", "when": "omacos-launch-app writing --has" },
  "apps.ai":             { "icon": "◇", "label": "AI", "action": "omacos-launch-app ai", "when": "omacos-launch-app ai --has" },
  "apps.ai-alt":         { "icon": "◆", "label": "The other AI", "action": "omacos-launch-app ai-alt", "when": "omacos-launch-app ai-alt --has" },
  "apps.chat":           { "icon": "◈", "label": "Messenger", "action": "omacos-launch-app chat", "when": "omacos-launch-app chat --has" },
  "apps.chat-alt":       { "icon": "◉", "label": "The other messenger", "action": "omacos-launch-app chat-alt", "when": "omacos-launch-app chat-alt --has" },
  "apps.messages":       { "icon": "✆", "label": "Messages", "action": "omacos-launch-app messages", "when": "omacos-launch-app messages --has" },
  "apps.photos":         { "icon": "▣", "label": "Photos", "action": "omacos-launch-app photos", "when": "omacos-launch-app photos --has" },
  "apps.x":              { "icon": "✕", "label": "X", "action": "omacos-launch-app x", "when": "omacos-launch-app x --has" },
  "apps.youtube":        { "icon": "▶", "label": "YouTube", "action": "omacos-launch-app youtube", "when": "omacos-launch-app youtube --has" },

  "capture":             { "icon": "⎙", "label": "Capture" },
  "capture.region":      { "icon": "▭", "label": "Screenshot a region", "action": "omacos-capture-screenshot region" },
  "capture.window":      { "icon": "❐", "label": "Screenshot a window", "action": "omacos-capture-screenshot window" },
  "capture.screen":      { "icon": "▣", "label": "Screenshot the screen", "action": "omacos-capture-screenshot fullscreen" },
  "capture.recording":   { "icon": "⏺", "label": "Start/stop a recording", "action": "omacos-capture-screenrecording region" },
  "capture.text":        { "icon": "⌸", "label": "Extract text (OCR)", "action": "omacos-capture-text" },
  "capture.url":         { "icon": "\u26ad", "label": "Copy the browser's URL", "action": "omacos-capture-url" },
  "capture.color":       { "icon": "◉", "label": "Pick a colour", "action": "omacos-capture-color" },

  "clipboard":           { "icon": "⎘", "label": "Clipboard" },
  "clipboard.history":   { "icon": "≡", "label": "History", "action": "omacos-clipboard-history" },
  "clipboard.clear":     { "icon": "⌫", "label": "Clear history", "action": "omacos-clipboard-clear" },
  "clipboard.watch-on":  { "icon": "●", "label": "Record history", "action": "omacos-setup-clipboard on", "when": "! omacos-setup-clipboard status >/dev/null" },
  "clipboard.watch-off": { "icon": "○", "label": "Stop recording history", "action": "omacos-setup-clipboard off", "when": "omacos-setup-clipboard status >/dev/null" },

  "trigger":             { "icon": "◷", "label": "Trigger" },
  "trigger.reminder":    { "icon": "⏲", "label": "Set a reminder", "action": "omacos-reminder" },
  "trigger.reminders":   { "icon": "≡", "label": "See reminders", "action": "omacos-reminder list; read -n 1 -s -r -p 'Press any key'" },
  "trigger.clear":       { "icon": "⌫", "label": "Clear reminders", "action": "omacos-reminder clear" },
  "trigger.time":        { "icon": "◴", "label": "Show the time", "action": "omacos-notice time" },
  "trigger.battery":     { "icon": "▮", "label": "Show the battery", "action": "omacos-notice battery" },
  "trigger.weather":     { "icon": "☂", "label": "Show the weather", "action": "omacos-notice weather" },

  "toggles":             { "icon": "⇄", "label": "Toggles" },
  "toggles.idle":        { "icon": "☕", "label": "Keep the screen awake", "action": "omacos-toggle-idle", "checked": "omacos-toggle-idle status >/dev/null" },
  "toggles.bar":         { "icon": "▬", "label": "Hide the top bar", "action": "omacos-toggle-bar", "checked": "omacos-state check bar-hidden" },
  "toggles.dnd":         { "icon": "\u25cc", "label": "Do Not Disturb", "action": "omacos-toggle-dnd", "when": "omacos-toggle-dnd status >/dev/null" },
  "toggles.dnd-setup":   { "icon": "\u2699", "label": "Set up Do Not Disturb", "action": "omacos-setup-dnd; read -n 1 -s -r -p 'Press any key'", "when": "! omacos-toggle-dnd status >/dev/null" },
  "toggles.gaps":        { "icon": "\u2637", "label": "Window gaps", "action": "omacos-toggle-gaps", "checked": "! omacos-state check gaps-off" },
  "toggles.audio":       { "icon": "\u266a", "label": "Next audio output", "action": "omacos-toggle-audio-output", "when": "command -v SwitchAudioSource" },
  "toggles.nightlight":  { "icon": "☾", "label": "Night Shift", "action": "omacos-toggle-nightlight" },
  "toggles.screensaver": { "icon": "▦", "label": "Start the screensaver", "action": "omacos-cmd-screensaver" },

  "setup":               { "icon": "⚙", "label": "Setup" },
  "setup.keybindings":   { "icon": "⌘", "label": "Keybindings", "action": "omacos-keymap-show; read -n 1 -s -r -p 'Press any key'" },
  "setup.keymap-build":  { "icon": "↻", "label": "Rebuild keymap", "action": "omacos-keymap-build" },
  "setup.zoom":          { "icon": "\u2315", "label": "Screen zoom", "action": "omacos-setup-zoom; read -n 1 -s -r -p 'Press any key'" },
  "setup.dictation":     { "icon": "◎", "label": "Dictation", "action": "omacos-setup-dictation" },
  "setup.clipboard":     { "icon": "⎘", "label": "Clipboard history", "action": "omacos-setup-clipboard status; read -n 1 -s -r -p 'Press any key'" },
  "setup.features":      { "icon": "⊞", "label": "Features", "action": "omacos-menu-feature" },
  "setup.doctor":        { "icon": "✚", "label": "Doctor", "action": "omacos-doctor; read -n 1 -s -r -p 'Press any key'" },
  "setup.edit-keymap":   { "icon": "✎", "label": "Edit keymap", "action": "${EDITOR:-nvim} ~/.config/omacos/keymap.conf && omacos-keymap-build" },
  "setup.edit-local":    { "icon": "✎", "label": "Edit local.env", "action": "${EDITOR:-nvim} ~/.config/omacos/local.env" },

  "update":              { "icon": "⇩", "label": "Update" },
  "update.omacos":       { "icon": "⇧", "label": "Update omacos", "action": "omacos-update" },
  "update.packages":     { "icon": "□", "label": "Update packages only", "action": "brew update && brew upgrade" },
  "update.migrations":   { "icon": "▶", "label": "Run pending migrations", "action": "omacos-migrate", "when": "omacos-migrate --pending" },

  "system":              { "icon": "▣", "label": "System" },
  "system.activity":     { "icon": "▤", "label": "Activity", "action": "btop" },
  "system.disk":         { "icon": "▦", "label": "Disk usage", "action": "df -h; read -n 1 -s -r -p 'Press any key'" },
  "system.wifi":         { "icon": "≋", "label": "Wi-Fi settings", "action": "open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" },
  "system.fonts":        { "icon": "\u0041", "label": "Fonts", "action": "omacos-font-list | less" },
  "system.displays":     { "icon": "▭", "label": "Displays", "action": "open 'x-apple.systempreferences:com.apple.Displays-Settings.extension'" },

  "power":               { "icon": "⏻", "label": "Power" },
  "power.lock":          { "icon": "🔒", "label": "Lock", "action": "pmset displaysleepnow" },
  "power.sleep":         { "icon": "☾", "label": "Sleep", "action": "pmset sleepnow" },
  "power.restart":       { "icon": "↻", "label": "Restart", "action": "osascript -e 'tell app \"System Events\" to restart'" },
  "power.shutdown":      { "icon": "⏼", "label": "Shut down", "action": "osascript -e 'tell app \"System Events\" to shut down'" }
}
